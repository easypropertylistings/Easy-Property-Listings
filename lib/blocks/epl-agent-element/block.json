{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "epl/agent-element",
	"version": "3.6.0",
	"title": "EPL Agent Element",
	"category": "epl",
	"icon": "businessperson",
	"description": "Display normalized listing-agent data from users or Staff Directory posts.",
	"textdomain": "easy-property-listings",
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"editorStyle": "file:./style.css",
	"usesContext": ["postId", "postType", "queryId"],
	"attributes": {
		"element": { "type": "string", "default": "card" },
		"previewPostType": { "type": "string", "default": "property" },
		"agentIndex": { "type": "number", "default": 1 },
		"link": { "type": "boolean", "default": true },
		"imageSize": { "type": "string", "default": "medium" },
		"listingsMode": { "type": "string", "default": "" },
		"tabStyle": { "type": "string", "default": "horizontal" }
	},
	"supports": {
		"anchor": true,
		"align": ["wide", "full"],
		"color": { "text": true, "background": true, "link": true },
		"spacing": { "margin": true, "padding": true, "blockGap": true },
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalDefaultControls": { "fontFamily": true, "fontSize": true, "fontAppearance": true }
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"html": false
	}
}
