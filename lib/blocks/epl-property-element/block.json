{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "epl/property-element",
	"version": "3.6.1",
	"title": "EPL Property Element",
	"category": "epl",
	"icon": "admin-home",
	"description": "Display a configurable element from the current EPL listing.",
	"textdomain": "easy-property-listings",
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"editorStyle": "file:./style.css",
	"usesContext": ["postId", "postType", "queryId"],
	"attributes": {
		"element": { "type": "string", "default": "title" },
		"previewPostType": { "type": "string", "default": "property" },
		"link": { "type": "boolean", "default": true },
		"imageSize": { "type": "string", "default": "large" },
		"showStickers": { "type": "boolean", "default": true },
		"enableImageHoverEffects": { "type": "boolean", "default": false },
		"imageHoverZoom": { "type": "number", "default": 105 },
		"imageHoverBlur": { "type": "number", "default": 0 },
		"imageHoverBrightness": { "type": "number", "default": 100 },
		"imageHoverContrast": { "type": "number", "default": 100 },
		"imageHoverSaturation": { "type": "number", "default": 100 },
		"imageHoverGrayscale": { "type": "number", "default": 0 },
		"imageHoverOpacity": { "type": "number", "default": 100 },
		"imageHoverDuration": { "type": "number", "default": 0.3 },
		"iconStyle": { "type": "string", "default": "i" },
		"metaKey": { "type": "string", "default": "" },
		"metaIcon": { "type": "string", "default": "" },
		"metaIconColor": { "type": "string", "default": "" },
		"metaIconSize": { "type": "number", "default": 20 },
		"prefix": { "type": "string", "default": "" },
		"suffix": { "type": "string", "default": "" },
		"taxonomy": { "type": "string", "default": "location" },
		"separator": { "type": "string", "default": ", " },
		"categoryTag": { "type": "string", "default": "div" },
		"categoryClass": { "type": "string", "default": "property-category" },
		"saleLabel": { "type": "string", "default": "For Sale" },
		"rentalLabel": { "type": "string", "default": "For Lease" },
		"commercialSaleLabel": { "type": "string", "default": "For Sale" },
		"commercialLeaseLabel": { "type": "string", "default": "For Lease" },
		"commercialBothLabel": { "type": "string", "default": "For Sale / Lease" },
		"underOfferLabel": { "type": "string", "default": "Under Offer" },
		"soldLabel": { "type": "string", "default": "Sold" },
		"leasedLabel": { "type": "string", "default": "Leased" },
		"withdrawnLabel": { "type": "string", "default": "Withdrawn" },
		"offmarketLabel": { "type": "string", "default": "Off Market" },
		"deletedLabel": { "type": "string", "default": "Deleted" },
		"statusColors": {
			"type": "object",
			"default": {
				"current-sale": "#7faf1b",
				"current-rental": "#7faf1b",
				"current-commercial-sale": "#7faf1b",
				"current-commercial-lease": "#7faf1b",
				"current-commercial-both": "#7faf1b",
				"under-offer": "#ffa042",
				"sold": "#ff6644",
				"leased": "#ff6644",
				"withdrawn": "#667085",
				"offmarket": "#667085",
				"deleted": "#b42318"
			}
		}
	},
	"supports": {
		"anchor": true,
		"align": ["wide", "full"],
		"color": { "text": true, "background": true, "link": true },
		"spacing": { "margin": true, "padding": true },
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalDefaultControls": {
				"fontFamily": true,
				"fontSize": true,
				"fontAppearance": true
			}
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"html": false
	}
}
