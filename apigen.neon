# ApiGen 7 settings for the EPL code reference (docs.easypropertylistings.com.au).
# Build with apigen/build.sh, not apigen directly: it adds the version to the
# title, the hook list, the EPL stylesheet and the redirects. See apigen/README.md.

parameters:
	# Everything that ships in the plugin. apigen/, node_modules/ and epl-apidocs/ stay out.
	paths:
		- easy-property-listings.php
		- uninstall.php
		- lib

	outputDir: '%workingDir%/epl-apidocs'

	# EPL theme: only the templates that differ from ApiGen's own.
	themeDir: '%workingDir%/apigen/theme'

	baseUrl: 'https://docs.easypropertylistings.com.au/'
